{
  "name": "confluence-axi",
  "version": "0.1.0",
  "description": "Owned, exact-origin read-only Confluence CLI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "confluence-axi": "bin/confluence-axi"
  },
  "files": [
    "bin",
    "dist",
    "skills/confluence-axi",
    "README.md"
  ],
  "engines": {
    "node": "v26.13.1"
  },
  "volta": {
    "node": "24.22.3"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist && chmod +x bin/confluence-axi",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/__tests__/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0"
  }
}
